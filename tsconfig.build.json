{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true
  },
  "include": [
    "index.ts",
    "configure.ts",
    "hooks.ts",
    "providers/**/*.ts",
    "src/**/*.ts",
    "stubs/**/*.ts"
  ],
  "exclude": ["node_modules", "build", "tests", "bin", "scripts"]
}
